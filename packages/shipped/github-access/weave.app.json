{
  "app": "github-access",
  "name": "GitHub access",
  "service": {
    "reads": {"kinds": ["weave.account"]},
    "writes": ["github.added"],
    "net": ["api.github.com"],
    "actions": [{"name": "status", "label": "See who gets access", "who": "members"}, {"name": "reachable", "label": "List the repositories it reaches", "who": "maintainers"}],
    "version": "1.0"
  },
  "wasm": {
    "component": "github-access.wasm",
    "panel": "panel",
    "panels": [{"name": "repos", "title": "Repositories", "who": "members", "page": "index.html", "covers": ["status", "reachable"]}]
  },
  "env": [
    {"name": "GITHUB_APP", "label": "Your GitHub App", "register": {"page": "https://github.com/settings/apps/new", "exchange": "https://api.github.com/app-manifests/{code}/conversions", "platform": "github", "manifest": {"name": "{account}'s Weave connect", "url": "https://github.com", "public": false, "default_permissions": {"administration": "write", "metadata": "read"}, "default_events": []}, "keep": ["id", "slug", "html_url", "owner.login"], "key": "pem", "then": "{html_url}/installations/new"}, "hint": "Yours, made once on GitHub: install it on the repositories members get access to. It only adds and removes collaborators there"},
    {"name": "REPOS", "label": "Repositories", "choose": {"action": "reachable", "many": true}, "optional": true, "hint": "The repositories the project's members get access to. None chosen: the project's own, where its releases come from"},
    {"name": "GITHUB_TOKEN", "label": "Or a GitHub token of yours", "yours": true, "secret": true, "optional": true, "hint": "Instead of an App: a token of yours (Administration: read and write on the repositories)"}
  ]
}
