{
  "app": "github-access",
  "name": "GitHub access",
  "service": {
    "reads": {"kinds": ["weave.account"]},
    "writes": ["github.added"],
    "net": ["api.github.com"],
    "uses": {"github": {"administration": "write", "metadata": "read"}},
    "actions": [{"name": "status", "label": "See who gets access", "who": "members"}],
    "version": "1.0"
  },
  "wasm": {
    "component": "github-access.wasm",
    "panel": "panel",
    "panels": [{"name": "repos", "title": "Repositories", "who": "members", "page": "index.html", "covers": ["status"]}]
  }
}
