# Weave Server settings for docker compose (copy to .env). Keep .env as safe as the server.

# The address admins and new colleagues open (Caddy gets its HTTPS certificate).
WEAVE_DOMAIN=weave.acme.example

# The company.
WEAVE_COMPANY=Acme
WEAVE_ADMINS=weave-admins

# The company's sign-in (OpenID Connect) and Weave's app registration with it.
WEAVE_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
WEAVE_CLIENT_ID=
# The admin console's app registration (defaults to the one above). Add https://<WEAVE_DOMAIN>/callback as its redirect address.
WEAVE_CONSOLE_CLIENT_ID=
WEAVE_CONSOLE_CLIENT_SECRET=

# The key service: vault or azure.
WEAVE_KEY_SERVICE=azure
# Azure Key Vault (an RSA key; employees need "Key Vault Crypto User" through a group, this server its own app).
WEAVE_AZURE_VAULT=https://acme-weave.vault.azure.net
WEAVE_AZURE_KEY=weave
WEAVE_AZURE_TENANT=
WEAVE_AZURE_CLIENT_ID=
WEAVE_AZURE_CLIENT_SECRET=
# Or HashiCorp Vault (Transit, a key created with derived=true).
# WEAVE_VAULT_ADDR=https://vault.acme.example
# WEAVE_VAULT_KEY=weave
# WEAVE_VAULT_ROLE=employees
# WEAVE_VAULT_TOKEN=

# Invitations by email (smtp://user:password@host:587 uses STARTTLS; smtps://…:465 TLS from the start).
WEAVE_SMTP_URL=
WEAVE_SMTP_FROM=weave@acme.example
