[Unit]
Description=Weave storage node
After=network-online.target
Wants=network-online.target

[Service]
User=weave-storage
Group=weave-storage
EnvironmentFile=/etc/weave-storage.env
# Pages may connect from WEAVE_PAGE. WEAVE_SERVE (setup.sh) is what serving the page here adds, or nothing when it comes
# from elsewhere (Cloudflare Pages): then this server sends no code a browser runs.
ExecStart=/usr/local/bin/node /opt/weave-storage/weave-storage.mjs run --behind-proxy --origin ${WEAVE_PAGE} $WEAVE_SERVE
Restart=always
RestartSec=5
LimitNOFILE=65536

# It needs its folder and the network, nothing else of this computer.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/weave-storage

[Install]
WantedBy=multi-user.target
