{
  "name": "weave",
  "version": "0.21.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev:mesh": "node scripts/dev-mesh.ts",
    "dev:testnet": "node scripts/dev-testnet.ts",
    "weave": "node packages/cli/src/main.ts",
    "desktop": "npm run start -w @weave/desktop --",
    "dev:web": "npm run web -w @weave/desktop --",
    "package": "npm run package -w @weave/desktop --",
    "dev:seed": "node scripts/dev-seed.ts",
    "release": "node scripts/release.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "^0.23.0",
    "@bytecodealliance/jco": "^1.39.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
